DATABASE_URL=postgresql+psycopg://job_copilot:change_me@postgres:5432/job_copilot
POSTGRES_USER=job_copilot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=job_copilot
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Resume storage
STORAGE_PATH=./storage
MAX_RESUME_SIZE_MB=10

# LLM analysis (default: "mock" = offline heuristic extraction, no API key needed)
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Job page fetching & URL import rate limit
JOB_FETCH_CONNECT_TIMEOUT=5
JOB_FETCH_TIMEOUT=20
JOB_FETCH_MAX_SIZE=2000000
JOB_FETCH_MAX_REDIRECTS=5
JOB_IMPORT_RATE_LIMIT=20
JOB_IMPORT_RATE_WINDOW=60

# Match embeddings (default: "deterministic" = offline, no extra dependencies)
EMBEDDING_PROVIDER=deterministic
# EMBEDDING_PROVIDER=sentence-transformers
# EMBEDDING_MODEL=all-MiniLM-L6-v2
